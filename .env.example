# MagickBook environment. Copy to .env.local and fill in what you need.
# Every variable is optional for local development: with none set, the app runs
# an in-memory MongoDB, seeds it, and offers passwordless demo sign-in.

# ---- Database --------------------------------------------------------------
# MongoDB connection string. Unset: an in-memory MongoDB, seeded on boot.
MONGODB_URI=
# "true" seeds a real (MONGODB_URI) database on boot when it is empty.
SEED_ON_BOOT=

# ---- Session ---------------------------------------------------------------
# Signs the session cookie (HS256). REQUIRED outside local dev; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ---- Firebase Auth (client) ------------------------------------------------
# With these set, the login screen uses Firebase (Google, email/password)
# instead of demo mode. Project settings > Your apps > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Auth (Admin SDK, verifies ID tokens) -------------------------
# Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes; they are expanded at runtime.
FIREBASE_PRIVATE_KEY=
# Alternative to the three above: path to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Sign-in rules ---------------------------------------------------------
# "true" / "false" forces passwordless demo sign-in on or off. Unset: on only
# while the Firebase client config is missing.
ALLOW_DEMO_LOGIN=
# Comma-separated email domains allowed to sign in and be invited, e.g.
#   @acme.in, @example.com
# Unset: anyone.
DOMAIN_WHITELIST=

# ---- File storage (invoice files, account documents) -----------------------
# The S3 bucket deployed by serverless.yaml for this stage, e.g.
# magickbook-invoices-dev. Unset: uploads return 501, everything else works.
INVOICES_BUCKET=
# Bucket region (S3_REGION is read as a fallback). Default: ap-south-1.
AWS_REGION=
# AWS credentials come from the standard AWS SDK chain (env vars, profile, role).

# ---- Links in reminders and Slack ------------------------------------------
# Absolute app URL used to build deep links in webhook payloads and Slack
# messages. APP_BASE_URL wins; NEXT_PUBLIC_APP_URL is the fallback.
APP_BASE_URL=
NEXT_PUBLIC_APP_URL=

# ---- Reminder delivery ------------------------------------------------------
# Shared secret for GET|POST /api/reminders/dispatch. The scheduler sends
# "Authorization: Bearer <CRON_SECRET>" to sweep every user's due reminders.
CRON_SECRET=

# ---- Slack notifications (lead lifecycle) ----------------------------------
# Incoming Webhook URL. Unset: notifications are off.
SLACK_WEBHOOK_URL=
# Optional overrides: channel id, bot name, and icon (emoji code or image URL).
SLACK_CHANNEL=
SLACK_BOT_NAME=
SLACK_BOT_ICON=
